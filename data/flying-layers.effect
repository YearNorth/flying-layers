// Draws a premultiplied-alpha texture with an extra opacity, optionally
// showing only part of it (uv_offset, uv_scale) for crops.
// The vertex shader and sampler follow libobs/data/default.effect of
// OBS Studio (GPL-2.0-or-later).
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float opacity;
uniform float2 uv_offset;
uniform float2 uv_scale;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = uv_offset + vert_in.uv * uv_scale;
	return vert_out;
}

float4 PSDraw(VertInOut vert_in) : TARGET
{
	return image.Sample(def_sampler, vert_in.uv) * opacity;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDraw(vert_in);
	}
}
